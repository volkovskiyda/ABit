# Formatting rules, read by ktlint (see build.gradle.kts) and by IntelliJ/Android Studio, so the
# editor and the build agree without either one holding a private copy. ktlint takes almost all of
# its behaviour from this file rather than from the Gradle extension — the plugin only decides which
# files to look at.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# ktlint's own house style, kept as the default on purpose: this codebase was written against it
# from the first commit, so there is no existing formatting for it to fight. It mandates trailing
# commas, rewraps signatures that cross the line limit, and puts a multiline expression on its own
# line after `=`. Nothing below disables a rule; if one ever has to go, the reason belongs here.
ktlint_code_style = ktlint_official

# ktlint_official's own default. Stated explicitly because detekt's MaxLineLength cannot read this
# file and carries the same number in config/detekt/detekt.yml — there is no shared source for it.
max_line_length = 140

# @Composable functions are PascalCase by convention — the same exemption detekt's FunctionNaming
# carries. Named annotations rather than the rule switched off, so a genuinely mis-named plain
# function is still caught. @PreviewTest is the screenshot plugin's marker, and its previews are
# composables too.
ktlint_function_naming_ignore_when_annotated_with = Composable, PreviewTest

[*.{json,yml,yaml,xml,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
