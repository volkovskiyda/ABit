<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch"/>

    <!-- Sync runs through Firestore from the watch itself, with no phone in the loop, so this app
         installs and works on its own. The Wearable Data Layer is deliberately not used. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The watch chimes from its own scheduler, not from a bridged phone notification (the phone
         manifest declares NO_BRIDGING). Same four permissions as the phone, for the same reasons. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:name=".AbitWearApplication"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
                android:name="com.google.android.wearable.standalone"
                android:value="true"/>

        <!-- The filter is what lets the scheduler resolve this class by name from a library module
             that cannot import it. Not exported: the action is package-qualified and the intent is
             made explicit before it is armed. -->
        <!-- The point of a watch app like this one: the next chime is one swipe from the watch face
             rather than an app launch. Exported and permission-guarded is what a tile provider is. -->
        <service
                android:exported="true"
                android:label="@string/tile_label"
                android:name=".tile.AbitTileService"
                android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER"/>
            </intent-filter>

            <meta-data
                    android:name="androidx.wear.tiles.PREVIEW"
                    android:resource="@drawable/tile_preview"/>
        </service>

        <receiver
                android:exported="false"
                android:name=".chime.ChimeReceiver">
            <intent-filter>
                <action android:name="com.gmail.volkovskiyda.abit.action.CHIME"/>
            </intent-filter>
        </receiver>

        <receiver
                android:exported="false"
                android:name=".chime.BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <activity
                android:exported="true"
                android:name=".MainActivity"
                android:taskAffinity=""
                android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>
