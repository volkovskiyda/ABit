<?xml version="1.0" encoding="utf-8"?>
<!--
  The tile picker's thumbnail. The dial on the icon's ground, reusing the launcher foreground rather
  than drawing a second mark: internal/design/icon/generate.py is the only source of this geometry.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background"/>
        </shape>
    </item>
    <item
            android:drawable="@drawable/ic_launcher_foreground"
            android:gravity="center"/>
</layer-list>
