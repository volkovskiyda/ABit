*.iml
.gradle
# Kotlin 2.x's per-project build state (.kotlin/sessions) — a build byproduct like .gradle above.
.kotlin
/local.properties
/.idea
.DS_Store
build
/captures
.externalNativeBuild
.cxx

# Git-ignored working files: plans, prompts, screenshots, scratch notes (see ~/.claude/CLAUDE.md).
/internal

# Secrets and per-machine config. Every real file here has a committed .example.* template, and a
# checkout without them still builds: the release signing config is simply not created, the Kotzilla
# plugin disables itself, and the Google Services plugin warns instead of failing. Only the delivery
# workflows restore the real files, from base64 repository secrets (scripts/restore-secrets.sh).
.env
.test.env
keystore.properties
*.jks
/firebase-ci.json
# Not at the repo root: the Kotzilla Gradle plugin reads this from the module it is applied to.
# It carries the ingestion API keys, one per build type.
kotzilla.json
# The real Firebase Android config, which carries the API key this project's keys are restricted to.
# google-services.example.json is its committed, placeholder-filled twin — documentation only, never
# read by the build.
google-services.json
# The Firebase CLI's local deploy/emulator cache. /.firebaserc and /firebase.json are deliberately
# NOT ignored: together they are what points this repo at the abit-kmp project, and they carry
# nothing beyond that id.
/.firebase/

# Android Studio's "Generate Signed Bundle / APK" wizard writes outside build/.
/app/*/release/
/app/*/debug/

# /debug.keystore is deliberately NOT ignored. It is committed so this machine, any contributor and
# CI all sign debug builds with the same certificate — the Firebase Android API key restriction is
# pinned to that SHA-1. It holds the conventional debug credentials and signs nothing that ships;
# only the release keystore above is secret.

# /.claude/settings.json is deliberately NOT ignored either — it sets CLOUDSDK_CORE_PROJECT so
# gcloud in this repo talks to the right project without a --project flag. Its .local counterparts
# are per-machine (permission decisions, absolute paths) and are not shareable.
/.claude/settings.local.json
/.claude/*.local.*
